[Unit]
Description=SeatWatch bus monitoring and manual payment website
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Change these paths if you move the project. Python loads .env from this directory.
WorkingDirectory=/home/windows/Downloads/ticket-bot-mcp-with-code/ticket-bot-mcp-code
ExecStart=/home/windows/Downloads/ticket-bot-mcp-with-code/ticket-bot-mcp-code/.venv/bin/python -m src.website.app
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
