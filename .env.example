APP_ENV=dev
DRY_RUN=true
LOG_LEVEL=INFO
CONSOLE_LOGS=false

POLL_INTERVAL_SECONDS=30
FAST_POLL_INTERVAL_SECONDS=5
MAX_RETRIES=3
MAX_TICKETS=2
MAX_TOTAL_PRICE=2000
PRICE_CURRENCY=BDT
TOP_OFFER_LIMIT=5
# Backward compatibility only. Prefer MAX_TOTAL_PRICE for non-USD sites.
# MAX_TOTAL_USD=200
AVAILABILITY_CONFIDENCE_THRESHOLD=0.75
AVAILABILITY_CONFIRMATION_SNAPSHOTS=2
PREFERRED_OPERATORS=
AVOID_OPERATORS=
PREFERRED_DEPARTURE_START=
PREFERRED_DEPARTURE_END=
AVOID_NIGHT_BUSES=false
TARGET_ORIGIN=
TARGET_DESTINATION=
REQUIRE_TRIP_SETUP=false

UI_ENABLED=true
UI_HOST=127.0.0.1
UI_PORT=8765
UI_PERSIST_AFTER_RUN=true

MCP_SERVER_URL=http://localhost:8931/mcp
MCP_COMMAND_TIMEOUT_SECONDS=30

TARGET_EVENT_URL=https://example.com/events/sample
# Optional JSON list. If set, this replaces TARGET_EVENT_URL as the monitor source.
# MONITOR_TARGETS_JSON=[{"id":"route-1","url":"https://example.com/a","label":"Route A","priority":1.5,"poll_min_seconds":5,"poll_max_seconds":60}]

PREFERRED_SECTIONS=Lower Bowl,Floor
AVOID_KEYWORDS=resale,VIP,platinum,obstructed

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

CUSTOMER_NAME=Sample User
CUSTOMER_EMAIL=user@example.com
CUSTOMER_PHONE=+10000000000

PAYMENT_METHOD_ALIAS=visa_personal
CARD_LAST4=1234
BILLING_ZIP=10001

# Multi-user website: python -m src.website.app
BOOKING_MODE=demo
WEBSITE_HOST=127.0.0.1
WEBSITE_PORT=8765
WEBSITE_PUBLIC_URL=http://127.0.0.1:8765
WEBSITE_DATABASE=data/tickets.sqlite3
# Set true behind an HTTPS reverse proxy in production.
WEBSITE_SECURE_COOKIES=false
WEBSITE_POLL_SECONDS=60
# Small-server resource limits; do not run multiple application workers.
WEBSITE_WORKER_CONCURRENCY=2
WEBSITE_BROWSER_LIMIT=4
WEBSITE_PROVIDER_TIMEOUT=90
WEBSITE_SESSION_IDLE_MINUTES=20
WEBSITE_DEPARTURE_BUFFER_MINUTES=5
# Private local backups: once at startup and every 24 hours; keep the latest 7.
WEBSITE_BACKUP_HOURS=24
WEBSITE_BACKUP_KEEP=7
# Leave blank for Playwright's installed Chromium, or specify a Chrome executable.
BROWSER_EXECUTABLE=

# Meta WhatsApp Cloud API. Keep credentials on the server only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use the supported Graph API version shown in your Meta app.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=ticket_booking_update
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
